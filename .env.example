# Bot token (xoxb-...) with channels:history, groups:history, files:read, users:read.
# The bot must be a member of every channel listed below.
SLACK_BOT_TOKEN=xoxb-replace-me

# Comma-separated channel ids, e.g. C0123ABCD,C0456EFGH
SLACK_CHANNEL_IDS=

# Distillation. An org-scoped key also needs ANTHROPIC_WORKSPACE_ID.
ANTHROPIC_API_KEY=sk-ant-replace-me
#ANTHROPIC_WORKSPACE_ID=

# Optional
#SLACK_INDEX_DISTILL_MODEL=claude-haiku-4-5
#SLACK_INDEX_EMBED_MODEL=nlpai-lab/KURE-v1
# Unset or 0 indexes the channel from its first message.
#SLACK_INDEX_LOOKBACK_DAYS=90
#SLACK_INDEX_POLL_SECONDS=60
#SLACK_INDEX_MAX_FILE_BYTES=5242880
#SLACK_INDEX_VAR_DIR=var
